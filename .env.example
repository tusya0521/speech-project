# Copy to .env and fill in. Never commit .env.
# Free key: https://console.groq.com/keys . Leave empty for fully offline mode.
GROQ_API_KEY=

# Local Whisper fallback. CPU / HF Space: base.en. RTX 4060: large-v3-turbo (about 2 GB VRAM in float16).
LOCAL_WHISPER_MODEL=base.en
LOCAL_WHISPER_DEVICE=auto

# Optional overrides (defaults shown)
# GROQ_ASR_MODEL=whisper-large-v3-turbo
# GROQ_LLM_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODEL=llama-3.1-8b-instant
# RETRIEVAL_MIN_CONFIDENCE=0.55
# ASR_REJECT_LOGPROB=-1.0
# ASR_ACCEPT_LOGPROB=-0.5
# ASR_NO_SPEECH_REJECT=0.6
# MAX_AUDIO_SECONDS=30
# MAX_UPLOAD_MB=20
# MAX_PAGES=300
# TTS_VOICE=en-US-AriaNeural
